# ICP Radar environment variables — all optional.
# Copy to .env.local for local dev; set in the Vercel dashboard for production.

# Powers the shared-key Challenger-outreach demo (Google AI Studio key).
# If unset, outreach simply requires each visitor to paste their own key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id overrides — only needed when a model id is deprecated (see HOW_IT_WORKS.md).
# GEMINI_MODEL=gemini-2.5-flash-lite
# NEXT_PUBLIC_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# NOTE: no Hugging Face token is required — the embedding model is fetched from the
# public HF CDN and runs in the browser.
